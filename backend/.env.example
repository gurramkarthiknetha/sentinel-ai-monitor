PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sentinel_ai_monitor
SOCKET_CORS_ORIGIN=http://localhost:5173
API_PREFIX=/api
CAMERA_OFFLINE_TIMEOUT_SECONDS=15
CAMERA_OFFLINE_CHECK_INTERVAL_SECONDS=5
JSON_BODY_LIMIT=1mb
DEBUG_DETECTIONS=false

# Google OAuth + JWT auth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional admin bootstrap emails (comma-separated).
# Matching Google users will be auto-assigned admin and auto-approved.
ADMINS=

# Legacy alias (optional):
# ADMIN_BOOTSTRAP_EMAILS=

# Worker API key used by RT-DETR worker to authenticate against protected ingestion endpoints.
WORKER_API_KEY=

# Optional external YOLO/FastAPI model endpoint used by worker for remote frame analysis.
# Example: PYTHONMODEL=http://127.0.0.1:8000
PYTHONMODEL=

# Ultralytics RT-DETR worker configuration
RTDETR_WORKER_ENABLED=true
RTDETR_AUTO_START_ON_BOOT=true
RTDETR_PYTHON_EXECUTABLE=
RTDETR_WORKER_SCRIPT=pythonmodel/rtdetr_crowd_worker.py
RTDETR_MODEL_PATH=./rtdetr-l.pt
RTDETR_API_BASE_URL=
RTDETR_DEVICE=auto
RTDETR_INPUT_SIZE=960
RTDETR_SCORE_THRESHOLD=0.25
RTDETR_IOU_THRESHOLD=0.7
RTDETR_PERSON_CLASS_ID=0
RTDETR_ALL_CLASSES=true
RTDETR_MAX_DETECTIONS=300
RTDETR_MIN_BOX_AREA_RATIO=0.0005
RTDETR_MAX_BOX_AREA_RATIO=0.9
RTDETR_EXCLUDE_CLASS_IDS=
RTDETR_FRAME_SKIP=1
RTDETR_STATUS_HEARTBEAT_SECONDS=8
RTDETR_BACKEND_TIMEOUT_SECONDS=2.5
RTDETR_RECONNECT_DELAY_SECONDS=2
RTDETR_LOG_EVERY_FRAMES=30
RTDETR_SYNC_INTERVAL_SECONDS=20
RTDETR_RESTART_DELAY_MS=3000
RTDETR_SHUTDOWN_GRACE_MS=5000
RTDETR_HALF=false
RTDETR_SHOW_PREVIEW=false
RTDETR_SEND_EMPTY=false
RTDETR_DEBUG_LOG_PAYLOAD=false
